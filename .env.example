# Скопируйте в .env (корень репозитория) и заполните. Файл .env не коммитится.

# --- Ядро ---
# Длинная случайная строка (мин. 32 символа): python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Локально по умолчанию SQLite (backend/bpm.db). Для Postgres:
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/bpm
# DATABASE_URL=

# Адрес фронтенда — подставляется в ссылки в письмах
FRONTEND_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# --- Почта (подтверждение адреса, восстановление пароля) ---
# Пока SMTP_HOST пуст — «dev-режим»: ссылки не отправляются письмом,
# а возвращаются в ответе API (подходит только для локального демо).
# Для Gmail: smtp.gmail.com, порт 587, «пароль приложения» вместо обычного.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=BPM Platform <no-reply@example.kz>

# --- Админка /admin ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Локально по http://localhost выключите Secure-cookie, иначе вход не сработает:
ADMIN_COOKIE_SECURE=false

# --- ИИ (OpenRouter) ---
OPENROUTER_API_KEY=
# Id моделей сверены с каталогом OpenRouter — менять только на существующие:
# LLM_MODEL=qwen/qwen3-235b-a22b-2507
# LLM_FALLBACK_MODELS=meta-llama/llama-3.3-70b-instruct,deepseek/deepseek-chat-v3.1

# --- Платежи ---
# mock — демо-провайдер (платёж «проходит» сам через 9 секунд, карта 4000 0000 0000 0002 — отказ)
# kaspi — боевой Kaspi Pay (реквизиты выдаёт Kaspi при онбординге мерчанта)
PAYMENT_PROVIDER=mock
# KASPI_API_KEY=
# KASPI_TRADE_POINT_ID=
# KASPI_DEVICE_TOKEN=
# KASPI_CERT_PATH=
# KASPI_CERT_KEY_PATH=
